# Smart Canteen - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# Flask secret key used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Flask environment: development | production | testing
FLASK_ENV=development

# Enable / disable Flask debug mode (never enable in production)
FLASK_DEBUG=1

# SQLite database location (relative to project root)
DATABASE_URL=sqlite:///instance/canteen.db

# Session cookie lifetime in seconds (default 7 days)
SESSION_LIFETIME_SECONDS=604800

# Maximum upload size for food images in bytes (default 5 MB)
MAX_UPLOAD_SIZE=5242880

# Host / port for the development server
HOST=0.0.0.0
PORT=5000

# Set to 1 to create demo accounts when running seed.py (development only)
SEED_DEMO_ACCOUNTS=1
